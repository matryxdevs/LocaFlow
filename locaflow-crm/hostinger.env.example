# EXEMPLO PARA HOSTINGER (não inclua senhas reais no repositório Git)
# Copie os valores para as variáveis de ambiente da aplicação no hPanel.
NODE_ENV=production
APP_ORIGIN=https://just-aquamarine-dunlin-37.hostingersite.com
# Use 1 apenas se a Hostinger estiver atrás de proxy HTTPS confiável.
TRUST_PROXY=1
# Se o provedor define PORT automaticamente, não configure manualmente.
SESSION_SECRET=COLE_CHAVE_ALEATORIA_GERADA_COM_96_CARACTERES
DB_HOST=localhost
DB_PORT=3306
DB_NAME=NOME_COMPLETO_DO_BANCO
DB_USER=USUARIO_COMPLETO_DO_BANCO
DB_PASSWORD=SENHA_REAL_DO_BANCO
DB_SSL=false
# Domínios legítimos alternativos, quando necessário, separados por vírgula:
# APP_ALLOWED_ORIGINS=https://crm.seudominio.com.br
