<%- include('partials/layout-open') %>
<section class="page-head"><div><span class="eyebrow">GESTÃO OPERACIONAL</span><h1><%= def.title %><span class="heading-dot">.</span></h1><p><%= def.subtitle %></p></div><a class="btn btn-primary" href="/<%= kind %>/novo"><%- include('partials/icon',{name:'plus'}) %> Novo <%= def.singular.toLowerCase() %></a></section>
<section class="surface list-surface"><div class="list-toolbar"><div><span class="eyebrow">BASE DE DADOS</span><h3>Registros cadastrados <span class="count-tag"><%= rows.length %><%= rows.length>=100?'+':'' %></span></h3></div><form method="GET" action="/<%= kind %>" class="search-form"><%- include('partials/icon',{name:'search'}) %><input type="search" name="q" value="<%= term %>" maxlength="80" placeholder="Buscar <%= kind==='vehicles'?'placa':kind==='clients'?'cliente':'oportunidade' %>" aria-label="Buscar registros"/><button type="submit">Buscar</button></form></div>
 <% if(rows.length){ %><div class="table-scroll"><table class="data-table"><thead><tr><% def.columns.forEach(([key,label])=>{ %><th><%= label %></th><% }) %><th class="align-right">Ações</th></tr></thead><tbody><% rows.forEach(item=>{ %><tr><% def.columns.forEach(([key,label])=>{ %><td><% if(isPill(key)){ %><span class="pill pill-<%= item[key] %>"><%= display(item,key) %></span><% }else if(key===def.columns[0][0]){ %><strong><%= display(item,key) %></strong><% }else{ %><%= display(item,key) %><% } %></td><% }) %><td><div class="table-actions"><a href="/<%= kind %>/<%= item.id %>/editar" class="action-button" aria-label="Editar registro" title="Editar"><%- include('partials/icon',{name:'edit'}) %></a><form method="POST" action="/<%= kind %>/<%= item.id %>/excluir" data-confirm="Confirma a exclusão permanente deste registro?"><input type="hidden" name="_csrf" value="<%= csrf %>"/><button type="submit" class="action-button danger" aria-label="Excluir registro" title="Excluir"><%- include('partials/icon',{name:'trash'}) %></button></form></div></td></tr><% }) %></tbody></table></div><div class="table-foot">Exibindo até 100 registros por consulta. Use a busca para filtrar.</div>
 <% }else{ %><div class="empty-state"><span><%- include('partials/icon',{name:def.icon}) %></span><h4><%= term?'Nenhum resultado encontrado':'Sua lista está vazia' %></h4><p><%= term?'Experimente outra busca.':'Adicione o primeiro registro para começar.' %></p><a href="/<%= kind %>/novo" class="btn btn-secondary"><%- include('partials/icon',{name:'plus'}) %> Criar registro</a></div><% } %>
</section>
<%- include('partials/layout-close') %>
