<%- include('partials/layout-open') %>
<section class="page-head"><div><a href="/locacoes" class="back-link"><%- include('partials/icon',{name:'arrow-left'}) %> Voltar às locações</a><h1>Nova locação<span class="heading-dot">.</span></h1><p>Reserve um veículo para um cliente. O sistema verifica conflitos de datas.</p></div></section>
<section class="surface form-surface"><div class="section-head form-heading"><div><span class="eyebrow">NOVA RESERVA</span><h3>Dados da locação</h3></div><span class="form-icon"><%- include('partials/icon',{name:'calendar'}) %></span></div>
<% if(!clients.length||!vehicles.length){ %><div class="notice info">É necessário cadastrar pelo menos um cliente e um veículo disponível antes da locação. <a href="<%= !clients.length?'/clients/novo':'/vehicles/novo' %>">Ir para o cadastro</a>.</div><% } %>
<form method="POST" action="/locacoes" class="data-form"><input type="hidden" name="_csrf" value="<%= csrf %>"/>
<div class="form-grid"><div class="form-field"><label for="client_id">Cliente *</label><select id="client_id" name="client_id" required><option value="">Selecione um cliente</option><% clients.forEach(c=>{ %><option value="<%= c.id %>"><%= c.full_name %></option><% }) %></select></div>
<div class="form-field"><label for="vehicle_id">Veículo *</label><select id="vehicle_id" name="vehicle_id" required><option value="">Selecione um veículo</option><% vehicles.forEach(v=>{ %><option value="<%= v.id %>" data-rate="<%= v.daily_rate %>"><%= v.brand %> <%= v.model %> · <%= v.plate %></option><% }) %></select></div>
<div class="form-field"><label for="start_date">Data da retirada *</label><input type="date" id="start_date" name="start_date" required/></div><div class="form-field"><label for="end_date">Data da devolução *</label><input type="date" id="end_date" name="end_date" required/></div>
<div class="form-field"><label for="daily_rate">Diária combinada (R$) *</label><input type="number" id="daily_rate" name="daily_rate" step="0.01" min="0" required placeholder="0,00"/></div><div class="form-field"><label>Estimativa total</label><div class="estimated-total" id="estimated-total">R$ 0,00 <span>valor calculado</span></div></div>
<div class="form-field span-full"><label for="notes">Observações</label><textarea id="notes" name="notes" maxlength="3000" rows="4" placeholder="Observações ou condições do aluguel"></textarea></div></div>
<p class="form-note"><%- include('partials/icon',{name:'info'}) %> A data final não é cobrada como uma diária extra. Conflitos com locações reservadas ou ativas são bloqueados.</p>
<div class="form-actions"><a href="/locacoes" class="btn btn-secondary">Cancelar</a><button type="submit" class="btn btn-primary" <%= !clients.length||!vehicles.length?'disabled':'' %>><%- include('partials/icon',{name:'check'}) %> Confirmar reserva</button></div></form></section>
<%- include('partials/layout-close') %>
