<%- include('partials/layout-open') %>
<section class="page-head"><div><span class="eyebrow">CENTRAL DE PERFORMANCE</span><h1>Visão geral <span class="heading-dot">.</span></h1><p>Acompanhe os números da <strong><%= currentUser.company_name %></strong> em tempo real.</p></div><a class="btn btn-primary" href="/locacoes/nova"><%- include('partials/icon',{name:'plus'}) %> Nova locação</a></section>
<section class="hero-banner"><div class="hero-content"><span class="hero-chip"><%- include('partials/icon',{name:'sparkles'}) %> O SEU NEGÓCIO EM MOVIMENTO</span><h2>Mais gestão. Menos planilhas.<br><span>Mais oportunidades.</span></h2><p>Organize todas as etapas da jornada de locação em uma única plataforma.</p><a href="/leads/novo">Cadastrar oportunidade <%- include('partials/icon',{name:'arrow-right'}) %></a></div><div class="hero-art" aria-hidden="true"><svg viewBox="0 0 440 230" fill="none"><ellipse cx="240" cy="184" rx="176" ry="24" fill="#041b25" opacity=".35"/><path d="M55 141h330l-20-44-61-22H166l-53 22-58 44Z" fill="#d5f4e2"/><path d="M144 104 169 82h130l45 22H144Z" fill="#91bba9"/><path d="M174 85h51v19h-73l22-19ZM232 85h63l38 19H232V85Z" fill="#1b5360"/><path d="M60 135h314c18 0 21 11 21 22v19H44v-23c0-11 5-18 16-18Z" fill="#f0fff4"/><path d="M44 166h351v15H44z" fill="#a4cfb9"/><circle cx="119" cy="178" r="31" fill="#0b2832"/><circle cx="119" cy="178" r="16" fill="#8fa7a8"/><circle cx="119" cy="178" r="8" fill="#e5eeec"/><circle cx="321" cy="178" r="31" fill="#0b2832"/><circle cx="321" cy="178" r="16" fill="#8fa7a8"/><circle cx="321" cy="178" r="8" fill="#e5eeec"/><path d="M55 148h39v11H50v-6c0-3 2-5 5-5ZM354 148h35v11h-35z" fill="#f7bd64"/><path d="M217 85v64M112 110h230" stroke="#8ab2a3" stroke-width="2"/><path d="M198 127h20M274 127h20" stroke="#45646a" stroke-width="4" stroke-linecap="round"/><path d="M84 69h35M340 49h50M366 67h24" stroke="#82b9a9" stroke-width="2" opacity=".6"/></svg></div></section>
<section class="metrics-grid" aria-label="Indicadores principais">
 <div class="metric-card"><span class="metric-label">Receita prevista do mês <span class="metric-icon"><%- include('partials/icon',{name:'briefcase'}) %></span></span><strong><%= brl(counts.monthly_revenue) %></strong><span class="metric-description"><span class="metric-accent">↗</span> Locações reservadas, ativas e finalizadas</span></div>
 <div class="metric-card"><span class="metric-label">Oportunidades abertas <span class="metric-icon"><%- include('partials/icon',{name:'target'}) %></span></span><strong><%= counts.open_leads %></strong><span class="metric-description">Negociações em andamento</span></div>
 <div class="metric-card"><span class="metric-label">Veículos disponíveis <span class="metric-icon"><%- include('partials/icon',{name:'car'}) %></span></span><strong><%= counts.available_vehicles %><span class="metric-of"> / <%= counts.total_vehicles %></span></strong><span class="metric-description">Frota cadastrada na plataforma</span></div>
 <div class="metric-card"><span class="metric-label">Locações em andamento <span class="metric-icon"><%- include('partials/icon',{name:'key'}) %></span></span><strong><%= counts.active_rentals %></strong><span class="metric-description"><%= counts.clients %> clientes no relacionamento</span></div>
</section>
<div class="dashboard-panels">
<section class="surface chart-panel"><div class="section-head"><div><span class="eyebrow">DESEMPENHO</span><h3>Volume de locações</h3><p>Últimos seis meses (por data de retirada)</p></div><span class="period-chip"><%- include('partials/icon',{name:'calendar'}) %> 6 meses</span></div><div class="chart-wrap"><canvas id="rental-chart" data-labels="<%= JSON.stringify(chart.map(x=>x.label)) %>" data-values="<%= JSON.stringify(chart.map(x=>x.total)) %>" role="img" aria-label="Gráfico de locações nos últimos seis meses"></canvas></div></section>
<section class="surface pipeline-panel"><div class="section-head"><div><span class="eyebrow">FUNIL COMERCIAL</span><h3>Etapas de negociação</h3><p>Distribuição das oportunidades</p></div></div><div class="pipeline-list">
 <% const stageOrder=[['novo','Novo contato'],['contato','Em contato'],['proposta','Proposta enviada'],['negociacao','Negociação'],['ganho','Convertidos'],['perdido','Perdidos']]; const totalStage=stages.reduce((s,x)=>s+Number(x.total),0); %>
 <% stageOrder.forEach(([key,label])=>{const amount=Number(stages.find(s=>s.stage===key)?.total||0);const width=totalStage?Math.round(amount/totalStage*100):0;%>
 <div class="pipeline-row"><span><i class="stage-indicator stage-<%= key %>"></i><%= label %></span><strong><%= amount %></strong><div class="pipeline-track"><svg viewBox="0 0 100 5" preserveAspectRatio="none" aria-hidden="true"><rect width="100" height="5" rx="2.5" fill="#edf1ee"/><rect width="<%= width %>" height="5" rx="2.5" fill="<%= key==='ganho'?'#2b9b73':key==='perdido'?'#9daeb0':'#6ba9a4' %>"/></svg></div></div>
 <% }) %></div><a class="text-link" href="/leads">Acessar oportunidades <%- include('partials/icon',{name:'arrow-right'}) %></a></section>
</div>
<section class="surface recent-panel"><div class="section-head"><div><span class="eyebrow">OPERAÇÕES RECENTES</span><h3>Últimas locações</h3><p>Histórico recente da operação</p></div><a href="/locacoes" class="btn btn-secondary btn-sm">Ver todas <%- include('partials/icon',{name:'arrow-right'}) %></a></div>
<% if(recent.length){ %><div class="table-scroll"><table class="data-table"><thead><tr><th>Cliente</th><th>Veículo</th><th>Retirada</th><th>Devolução</th><th>Valor</th><th>Situação</th></tr></thead><tbody><% recent.forEach(r=>{ %><tr><td><strong><%= r.client_name %></strong></td><td><%= r.vehicle_name %><span class="subcell"><%= r.plate %></span></td><td><%= fmtDate(r.start_date) %></td><td><%= fmtDate(r.end_date) %></td><td class="strong-cell"><%= brl(r.total_value) %></td><td><span class="pill pill-<%= r.status %>"><%= nice(r.status) %></span></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state"><span><%- include('partials/icon',{name:'car'}) %></span><h4>Seu painel começa aqui</h4><p>Cadastre clientes e veículos para registrar a primeira locação.</p><a href="/vehicles/novo" class="btn btn-secondary">Cadastrar veículo</a></div><% } %>
</section>
<script src="/static/js/dashboard.js" defer></script>
<%- include('partials/layout-close') %>
