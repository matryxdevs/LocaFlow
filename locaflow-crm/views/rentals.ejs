<%- include('partials/layout-open') %>
<section class="page-head"><div><span class="eyebrow">CONTROLE DE RESERVAS</span><h1>Locações<span class="heading-dot">.</span></h1><p>Acompanhe reservas, contratos em andamento e devoluções.</p></div><a href="/locacoes/nova" class="btn btn-primary"><%- include('partials/icon',{name:'plus'}) %> Nova locação</a></section>
<section class="surface list-surface"><div class="list-toolbar"><div><span class="eyebrow">MOVIMENTAÇÕES</span><h3>Reservas e locações <span class="count-tag"><%= rows.length %><%= rows.length>=100?'+':'' %></span></h3></div><span class="list-helper">Dados da sua empresa</span></div>
<% if(rows.length){ %><div class="table-scroll"><table class="data-table"><thead><tr><th>Cliente</th><th>Veículo</th><th>Período</th><th>Diária</th><th>Total</th><th>Situação</th><th class="align-right">Ação</th></tr></thead><tbody>
<% rows.forEach(r=>{ %><tr><td><strong><%= r.client_name %></strong></td><td><%= r.vehicle_name %><span class="subcell"><%= r.plate %></span></td><td><%= fmtDate(r.start_date) %><span class="subcell">até <%= fmtDate(r.end_date) %></span></td><td><%= brl(r.daily_rate) %></td><td class="strong-cell"><%= brl(r.total_value) %></td><td><span class="pill pill-<%= r.status %>"><%= nice(r.status) %></span></td><td><div class="table-actions"><% if(r.status==='reservada'||r.status==='ativa'){%><form method="POST" action="/locacoes/<%= r.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"/><input type="hidden" name="status" value="<%= r.status==='reservada'?'ativa':'finalizada' %>"/><button class="mini-action" type="submit"><%= r.status==='reservada'?'Iniciar':'Finalizar' %></button></form><form method="POST" action="/locacoes/<%= r.id %>/status" data-confirm="Cancelar esta locação?"><input type="hidden" name="_csrf" value="<%= csrf %>"/><input type="hidden" name="status" value="cancelada"/><button type="submit" class="action-button danger" title="Cancelar locação" aria-label="Cancelar locação"><%- include('partials/icon',{name:'trash'}) %></button></form><% }else{ %><span class="disabled-action">Concluída</span><% } %></div></td></tr><% }) %></tbody></table></div><div class="table-foot">Período: a devolução é exclusiva na data final para cálculo de diárias. Exibindo até 100 registros.</div>
<% }else{ %><div class="empty-state"><span><%- include('partials/icon',{name:'key'}) %></span><h4>Nenhuma locação registrada</h4><p>Selecione um cliente e um veículo para registrar sua primeira reserva.</p><a class="btn btn-secondary" href="/locacoes/nova">Começar agora</a></div><% } %></section>
<%- include('partials/layout-close') %>
