<%- include('partials/layout-open') %>
<section class="page-head"><div><span class="eyebrow">SEGURANÇA DA CONTA</span><h1>Minha conta<span class="heading-dot">.</span></h1><p>Revise seu acesso e mantenha sua senha protegida.</p></div></section>
<section class="surface form-surface"><div class="section-head form-heading"><div><span class="eyebrow">PERFIL AUTENTICADO</span><h3><%= currentUser.full_name %></h3><p><%= currentUser.email %> · <%= currentUser.role==='superadmin'?'Administração da plataforma':currentUser.company_name %></p></div><span class="form-icon"><%- include('partials/icon',{name:'shield'}) %></span></div><form method="POST" action="/conta/senha" class="data-form"><input type="hidden" name="_csrf" value="<%= csrf %>"/><div class="form-grid"><div class="form-field span-full"><label for="current_password">Senha atual *</label><input id="current_password" name="current_password" type="password" required autocomplete="current-password" /></div><div class="form-field span-full"><label for="new_password">Nova senha *</label><input id="new_password" name="new_password" type="password" minlength="12" maxlength="128" required autocomplete="new-password" /></div></div><p class="form-note">Use pelo menos 12 caracteres com letra maiúscula, minúscula, número e símbolo. A alteração invalida as outras sessões.</p><div class="form-actions"><button type="submit" class="btn btn-primary"><%- include('partials/icon',{name:'lock'}) %> Atualizar senha</button></div></form></section>
<%- include('partials/layout-close') %>
