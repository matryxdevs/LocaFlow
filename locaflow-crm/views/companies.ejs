<%- include('partials/layout-open') %>
<section class="page-head"><div><span class="eyebrow">ADMINISTRAÇÃO MULTIEMPRESA</span><h1>Empresas<span class="heading-dot">.</span></h1><p>Cadastre locadoras e gerencie acessos independentes na plataforma.</p></div><a href="#cadastrar" class="btn btn-primary"><%- include('partials/icon',{name:'plus'}) %> Adicionar empresa</a></section>
<section class="admin-overview"><div class="admin-stat"><span>Empresas cadastradas</span><strong><%= companies.length %><%= companies.length===200?'+':'' %></strong></div><div class="admin-stat"><span>Empresas ativas</span><strong><%= companies.filter(c=>c.status==='active').length %></strong></div><div class="admin-stat"><span>Usuários vinculados</span><strong><%= companies.reduce((n,c)=>n+Number(c.users_count),0) %></strong></div></section>
<div class="admin-layout"><section class="surface list-surface admin-list"><div class="section-head"><div><span class="eyebrow">CLIENTES DA PLATAFORMA</span><h3>Locadoras cadastradas</h3></div></div><% if(companies.length){ %><div class="table-scroll"><table class="data-table"><thead><tr><th>Empresa</th><th>Plano</th><th>Usuários</th><th>Veículos</th><th>Status</th><th>Ação</th></tr></thead><tbody><% companies.forEach(c=>{ %><tr><td><strong><%= c.name %></strong><span class="subcell"><%= c.email %></span></td><td class="capitalize"><%= c.plan %></td><td><%= c.users_count %></td><td><%= c.vehicles_count %></td><td><span class="pill pill-<%= c.status %>"><%= c.status==='active'?'Ativa':'Suspensa' %></span></td><td><form method="POST" action="/empresas/<%= c.id %>/status" data-confirm="Deseja <%= c.status==='active'?'suspender':'reativar' %> o acesso desta empresa?"><input type="hidden" name="_csrf" value="<%= csrf %>"/><button class="mini-action <%= c.status==='active'?'subtle-danger':'' %>" type="submit"><%= c.status==='active'?'Suspender':'Reativar' %></button></form></td></tr><% }) %></tbody></table></div><div class="table-foot">Cada empresa possui dados e usuários separados. Exibição limitada às últimas 200 empresas.</div><% }else{ %><div class="empty-state"><span><%- include('partials/icon',{name:'building'}) %></span><h4>Cadastre a primeira locadora</h4><p>Use o formulário ao lado para criar a empresa e seu gestor.</p></div><% } %></section>
<section class="surface admin-form" id="cadastrar"><div class="section-head"><div><span class="eyebrow">NOVO CLIENTE B2B</span><h3>Cadastrar locadora</h3></div></div><form method="POST" action="/empresas" class="data-form"><input type="hidden" name="_csrf" value="<%= csrf %>"/>
<h4 class="form-subheading">Dados da empresa</h4><div class="form-field"><label for="company-name">Nome fantasia *</label><input id="company-name" name="name" maxlength="150" required placeholder="Ex.: Locadora Premium"/></div>
<div class="form-field"><label for="legal_name">Razão social</label><input id="legal_name" name="legal_name" maxlength="180"/></div><div class="form-field"><label for="document">CNPJ</label><input id="document" name="document" maxlength="20" inputmode="numeric" placeholder="Somente números"/></div>
<div class="form-field"><label for="c-email">E-mail comercial *</label><input id="c-email" type="email" name="email" maxlength="190" required/></div><div class="form-field"><label for="phone">Telefone</label><input id="phone" name="phone" maxlength="30"/></div><div class="form-field"><label for="plan">Plano</label><select id="plan" name="plan"><option value="starter">Starter</option><option value="business">Business</option><option value="enterprise">Enterprise</option></select></div>
<h4 class="form-subheading">Gestor da locadora</h4><div class="form-field"><label for="owner_name">Nome completo *</label><input id="owner_name" name="owner_name" maxlength="120" required/></div><div class="form-field"><label for="owner_email">E-mail de acesso *</label><input id="owner_email" name="owner_email" type="email" maxlength="190" required/></div><div class="form-field"><label for="owner_password">Senha inicial *</label><input id="owner_password" name="owner_password" type="password" minlength="12" maxlength="128" autocomplete="new-password" required/></div><p class="form-note">Mínimo de 12 caracteres, com letra maiúscula, minúscula, número e símbolo. Compartilhe por canal seguro.</p><button class="btn btn-primary btn-full" type="submit"><%- include('partials/icon',{name:'plus'}) %> Criar empresa e gestor</button></form></section></div>
<%- include('partials/layout-close') %>
