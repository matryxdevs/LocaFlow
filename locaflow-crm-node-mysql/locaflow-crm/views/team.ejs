<%- include('partials/layout-open') %>
<section class="page-head"><div><span class="eyebrow">ACESSOS E PERMISSÕES</span><h1>Equipe<span class="heading-dot">.</span></h1><p>Gerencie operadores e gestores da sua locadora.</p></div><a href="#novo-usuario" class="btn btn-primary"><%- include('partials/icon',{name:'plus'}) %> Adicionar usuário</a></section>
<div class="admin-layout"><section class="surface list-surface admin-list"><div class="section-head"><div><span class="eyebrow">PESSOAS COM ACESSO</span><h3>Usuários da empresa</h3></div></div><div class="table-scroll"><table class="data-table"><thead><tr><th>Nome</th><th>E-mail</th><th>Perfil</th><th>Status</th><th>Ação</th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><strong><%= u.full_name %></strong></td><td><%= u.email %></td><td><%= u.role==='company_admin'?'Gestor':'Operador' %></td><td><span class="pill pill-<%= u.is_active?'active':'inactive' %>"><%= u.is_active?'Ativo':'Inativo' %></span></td><td><% if(u.id!==currentUser.id){ %><form method="POST" action="/equipe/<%= u.id %>/status" data-confirm="Deseja alterar o acesso desta conta?"><input type="hidden" name="_csrf" value="<%= csrf %>"/><button class="mini-action" type="submit"><%= u.is_active?'Desativar':'Ativar' %></button></form><% }else{ %><span class="disabled-action">Sua conta</span><% } %></td></tr><% }) %></tbody></table></div></section>
<section class="surface admin-form" id="novo-usuario"><div class="section-head"><div><span class="eyebrow">CONTROLE DE ACESSO</span><h3>Novo membro</h3></div></div><form method="POST" action="/equipe" class="data-form"><input type="hidden" name="_csrf" value="<%= csrf %>"/>
<div class="form-field"><label for="full_name">Nome completo *</label><input id="full_name" name="full_name" maxlength="120" required/></div><div class="form-field"><label for="email">E-mail corporativo *</label><input id="email" name="email" type="email" maxlength="190" required/></div><div class="form-field"><label for="role">Nível de acesso *</label><select id="role" name="role"><option value="agent">Operador</option><option value="company_admin">Gestor da locadora</option></select></div><div class="form-field"><label for="password">Senha inicial *</label><input id="password" name="password" type="password" minlength="12" maxlength="128" required autocomplete="new-password"/></div><p class="form-note">A senha deve conter letras maiúsculas, minúsculas, números e símbolos. Use uma senha exclusiva.</p><button class="btn btn-primary btn-full" type="submit">Criar acesso</button></form><div class="reset-section"><h4 class="form-subheading">Redefinir acesso de colaborador</h4><p class="form-note">Para redefinir a senha de um membro, selecione o usuário abaixo. Todas as sessões anteriores serão invalidadas.</p><form method="POST" action="/equipe/<%= users.find(u=>u.id!==currentUser.id)?.id||0 %>/reset" id="reset-team-form" class="data-form"><input type="hidden" name="_csrf" value="<%= csrf %>"/><div class="form-field"><label for="reset-user">Usuário</label><select id="reset-user"><% users.filter(u=>u.id!==currentUser.id).forEach(u=>{ %><option value="<%= u.id %>"><%= u.full_name %></option><% }) %></select></div><div class="form-field"><label for="reset-password">Nova senha *</label><input type="password" name="new_password" id="reset-password" minlength="12" maxlength="128" required autocomplete="new-password"/></div><button type="submit" class="btn btn-secondary" <%= users.filter(u=>u.id!==currentUser.id).length?'':'disabled' %>>Redefinir senha</button></form></div></section></div>
<%- include('partials/layout-close') %>
