<%- include('partials/head') %>
<body class="login-body">
 <main class="login-shell">
  <section class="login-showcase" aria-label="Apresentação da plataforma">
   <div class="login-showcase-inner">
    <div class="login-brand"><span class="brand-mark"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M5 17.5 11 6l4.2 7H21" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><circle cx="18.6" cy="18.4" r="2.7" fill="currentColor"/></svg></span><span>locaflow<small>CRM PARA LOCADORAS</small></span></div>
    <div class="login-story"><span class="eyebrow light">TECNOLOGIA PARA LOCADORAS</span><h1>Seu negócio em movimento. <em>Seu controle em dia.</em></h1><p>Centralize sua equipe, oportunidades, clientes, frota e locações em um único lugar.</p></div>
    <div class="login-preview"><div class="preview-top"><span class="preview-logo-circle"></span><span>Visão do negócio</span><span class="preview-live">● Atualizado</span></div><div class="preview-graph"><div class="preview-line"></div><svg viewBox="0 0 420 140" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="gr" x1="0" x2="0" y1="0" y2="1"><stop stop-color="#72d6aa" stop-opacity=".35"/><stop offset="1" stop-color="#72d6aa" stop-opacity="0"/></linearGradient></defs><path d="M0 119C30 118 38 65 74 79S120 114 149 80 197 83 231 53 280 94 314 46 372 68 420 14L420 140H0Z" fill="url(#gr)"/><path d="M0 119C30 118 38 65 74 79S120 114 149 80 197 83 231 53 280 94 314 46 372 68 420 14" fill="none" stroke="#80e4b3" stroke-width="3" stroke-linecap="round"/></svg></div><div class="preview-cards"><div><small>FROTA</small><strong>100%</strong><span>Visibilidade</span></div><div><small>CRM</small><strong>360°</strong><span>Relacionamento</span></div><div><small>GESTÃO</small><strong>24/7</strong><span>Centralizada</span></div></div></div>
    <div class="showcase-footer"><%- include('partials/icon',{name:'shield'}) %> Dados isolados por empresa · Acesso autenticado</div>
   </div>
  </section>
  <section class="login-panel"><div class="login-panel-content"><span class="mobile-logo"><span class="brand-mark">L</span> locaflow</span><span class="eyebrow">ACESSO À PLATAFORMA</span><h2>Bem-vindo de volta</h2><p class="muted">Entre com suas credenciais para gerenciar a operação.</p>
   <% if(invalid){ %><div class="notice error">E-mail ou senha incorretos, ou conta sem acesso.</div><% } %>
   <% if(expired){ %><div class="notice error">Seu acesso expirou ou sua conta foi desativada.</div><% } %>
   <form method="POST" action="/login" class="login-form"><input type="hidden" name="_csrf" value="<%= csrf %>"/>
    <label for="email">E-mail profissional</label><input id="email" name="email" type="email" maxlength="190" required autocomplete="username" placeholder="voce@empresa.com.br"/>
    <label for="password">Senha</label><input id="password" name="password" type="password" required autocomplete="current-password" placeholder="Digite sua senha"/>
    <button class="btn btn-primary btn-full" type="submit">Acessar meu painel <%- include('partials/icon',{name:'arrow-right'}) %></button>
   </form>
   <div class="login-help"><%- include('partials/icon',{name:'lock'}) %><span>Conexão protegida. Nunca compartilhe sua senha.</span></div>
  </div><div class="login-panel-footer">LocaFlow CRM · Gestão inteligente de locadoras</div></section>
 </main>
</body></html>
